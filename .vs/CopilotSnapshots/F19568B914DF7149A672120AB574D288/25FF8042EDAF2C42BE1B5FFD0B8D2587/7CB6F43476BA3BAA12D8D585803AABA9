@page "/add-transaction"
@rendermode InteractiveServer

@using FinanzAladin.Models;
@using FinanzAladin.Services;
@inject TransactionService TransactionService
@inject NavigationManager NavigationManager

<PageTitle>Transaktion hinzufügen</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1>Transaktion hinzufügen</h1>

            <EditForm Model="transaction" OnValidSubmit="SaveTransaction" class="mt-4">
                <DataAnnotationsValidator />
                <ValidationSummary class="alert alert-danger" role="alert" />

                <div class="mb-3">
                    <label class="form-label" for="title">Titel: <span class="text-danger">*</span></label>
                    <InputText class="form-control" id="title" @bind-Value="transaction.Title" placeholder="z.B. Gehalt, Einkauf..." />
                    <ValidationMessage For="() => transaction.Title" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="amount">Betrag (€): <span class="text-danger">*</span></label>
                    <InputNumber class="form-control" id="amount" @bind-Value="transaction.Amount" placeholder="0.00" />
                    <ValidationMessage For="() => transaction.Amount" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="date">Datum: <span class="text-danger">*</span></label>
                    <InputDate class="form-control" id="date" @bind-Value="transaction.Date" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="type">Typ: <span class="text-danger">*</span></label>
                        <InputSelect class="form-select" id="type" @bind-Value="transaction.Type">
                            <option value="@TransactionType.Expense">Ausgabe</option>
                            <option value="@TransactionType.Income">Einnahme</option>
                        </InputSelect>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="category">Kategorie:</label>
                        <InputText class="form-control" id="category" @bind-Value="transaction.Category" placeholder="z.B. Lebensmittel..." />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="note">Notiz:</label>
                    <InputTextArea class="form-control" id="note" @bind-Value="transaction.Note" placeholder="Optionale Anmerkung..." rows="3" />
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" type="submit" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Wird gespeichert...</span>
                        }
                        else
                        {
                            <span>Speichern</span>
                        }
                    </button>
                    <button class="btn btn-secondary" type="button" @onclick="Cancel" disabled="@isSaving">Abbrechen</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private FinanzAladin.Models.Transaction transaction = new();
    private bool isSaving = false;

    private async Task SaveTransaction()
    {
        isSaving = true;
        try
        {
            await TransactionService.AddTransactionAsync(transaction);
            NavigationManager.NavigateTo("/transactions");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Fehler beim Speichern: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/dashboard");
    }
}
