@page "/dashboard"
@rendermode InteractiveServer

@using FinanzAladin.Services;
@inject TransactionService TransactionService
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Dashboard</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="min-vh-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="card border-0 rounded-4 shadow-lg p-5" style="max-width: 500px;">
            <div class="text-center">
                <span class="display-1 mb-3" style="font-size: 4rem;">🔐</span>
                <h3 class="fw-bold mb-3">Zugriff verweigert</h3>
                <p class="text-muted mb-4">Du musst angemeldet sein, um dein Dashboard zu sehen.</p>
                <a class="btn btn-primary btn-lg rounded-3" href="/login">🚀 Zur Anmeldeseite</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="min-vh-100" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="container py-5">
            <div class="row mb-5">
                <div class="col-12">
                    <h1 class="display-4 fw-bold text-white mb-2">💰 FinanzAladin</h1>
                    <p class="text-white-50 fs-5">Dein persönlicher Finanzmanager</p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>❌ Fehler:</strong> @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                </div>
            }

            @if (isLoading)
            {
                <div class="row">
                    <div class="col-12 text-center">
                        <div class="spinner-border text-white" role="status">
                            <span class="visually-hidden">Laden...</span>
                        </div>
                        <p class="text-white mt-3">Deine Daten werden geladen...</p>
                    </div>
                </div>
            }
            else
            {
                <!-- Statistik-Cards -->
                <div class="row g-4 mb-5">
                    <div class="col-md-4">
                        <div class="card h-100 shadow-lg border-0 rounded-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); overflow: hidden;">
                            <div class="card-body text-white">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <p class="card-text small mb-2 opacity-75">Kontostand</p>
                                        <h2 class="card-title display-6 fw-bold">
                                            @balance.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("de-DE"))
                                        </h2>
                                    </div>
                                    <span class="fs-3">💳</span>
                                </div>
                                <small class="opacity-75">Einnahmen - Ausgaben</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card h-100 shadow-lg border-0 rounded-4" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); overflow: hidden;">
                            <div class="card-body text-white">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <p class="card-text small mb-2 opacity-75">Einnahmen</p>
                                        <h2 class="card-title display-6 fw-bold">
                                            +@income.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("de-DE"))
                                        </h2>
                                    </div>
                                    <span class="fs-3">📈</span>
                                </div>
                                <small class="opacity-75">Gesamte Einnahmen</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card h-100 shadow-lg border-0 rounded-4" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); overflow: hidden;">
                            <div class="card-body text-white">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <p class="card-text small mb-2 opacity-75">Ausgaben</p>
                                        <h2 class="card-title display-6 fw-bold">
                                            -@expenses.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("de-DE"))
                                        </h2>
                                    </div>
                                    <span class="fs-3">📉</span>
                                </div>
                                <small class="opacity-75">Gesamte Ausgaben</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <a class="btn btn-light btn-lg w-100 rounded-3 shadow fw-semibold" href="/add-transaction">
                            <span class="me-2">➕</span> Neue Buchung
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a class="btn btn-outline-light btn-lg w-100 rounded-3 fw-semibold" href="/transactions">
                            <span class="me-2">📋</span> Alle Buchungen
                        </a>
                    </div>
                </div>

                <!-- Info Card -->
                <div class="card bg-white bg-opacity-10 border-light rounded-4 shadow">
                    <div class="card-body text-white">
                        <h5 class="card-title mb-2">💡 Tipp</h5>
                        <p class="card-text small mb-0">
                            Verwalte deine Transaktionen einfach und behalte deinen Finanzstatus jederzeit im Überblick. 
                            Füge neue Buchungen hinzu und analysiere deine Ausgaben!
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private decimal balance = 0;
    private decimal income = 0;
    private decimal expenses = 0;
    private bool isLoading = true;
    private string? errorMessage = null;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated || AuthService.CurrentUser == null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            int userId = AuthService.CurrentUser!.Id;
            income = await TransactionService.GetIncomeAsync(userId);
            expenses = await TransactionService.GetExpensesAsync(userId);
            balance = await TransactionService.GetBalanceAsync(userId);
        }
        catch (Exception ex)
        {
            errorMessage = $"Fehler beim Laden der Daten: {ex.Message}";
            Console.WriteLine($"Dashboard Error: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
